import { BLOCKS } from '@contentful/rich-text-types';
import type { Meta, StoryObj } from '@storybook/react';

import { IconProps } from '@/basics/icons';
import {
  createRichText,
  createRichTextLinkNode,
  createRichTextTextNode,
  createRichTextTopLevelBlockNode,
  mediumText
} from '@/content';

import { FormMessage } from './formMessage';

const meta = {
  component: FormMessage
} satisfies Meta<typeof FormMessage>;

export default meta;
type Story = StoryObj<typeof meta>;

// ----------------------------------------
// Shared fixtures
// ----------------------------------------
const richTextContent = createRichText({
  content: [
    createRichTextTopLevelBlockNode({
      nodeType: BLOCKS.PARAGRAPH,
      content: [
        createRichTextTextNode({
          value: 'Please try again. If the problem persists, '
        }),
        createRichTextLinkNode({
          text: 'Contact Customer Support',
          uri: '/support'
        })
      ]
    })
  ]
});

const shortMessage =
  'Please note that our Thalassotherapy Spa will remain closed until 29 March 2025.';

const longMessage =
  'Please note that our Thalassotherapy Spa will remain closed for light refurbishments until 29 March 2025. We will be open on next April. We will see you then. Thank you.';

const infoIconLarge: IconProps = { slug: 'warning', size: 'large' };

// ----------------------------------------
// Success — centered, all caps
// ----------------------------------------

/** Single line: icon + text should be centered in a row */
export const SuccessSingleLine: Story = {
  args: {
    type: 'success',
    iconProps: infoIconLarge,
    children: 'Form submitted successfully.'
  }
};

/**
 * Multi-line: icon should stack ABOVE text (column layout),
 * text stays centered below icon
 */
export const SuccessMultiLine: Story = {
  args: {
    type: 'success',
    iconProps: infoIconLarge,
    children: mediumText
  }
};

/** No icon: just centered text */
export const SuccessNoIcon: Story = {
  args: {
    type: 'success',
    children: 'Form submitted successfully.'
  }
};

// ----------------------------------------
// Error — centered, all caps (same layout as success)
// ----------------------------------------

/** Single line error with icon */
export const ErrorSingleLine: Story = {
  args: {
    type: 'error',
    iconProps: infoIconLarge,
    children: 'Something went wrong. Please try again.'
  }
};

/**
 * Multi-line: icon stacks above centered text
 */
export const ErrorMultiLine: Story = {
  args: {
    type: 'error',
    iconProps: infoIconLarge,
    message: longMessage
  }
};

/** Error with rich text — no icon */
export const ErrorWithRichText: Story = {
  args: {
    type: 'error',
    message: richTextContent
  }
};

/** Error with rich text + icon */
export const ErrorWithIconAndRichText: Story = {
  args: {
    type: 'error',
    iconProps: infoIconLarge,
    message: richTextContent
  }
};

// ----------------------------------------
// Info standalone (no header)
// Left-aligned, all caps, icon at top for multi-line
// ----------------------------------------

/** Single line: icon optically aligns with the single line of text */
export const InfoStandaloneSingleLine: Story = {
  args: {
    type: 'info',
    iconProps: infoIconLarge,
    message: shortMessage
  }
};

/** Multi-line: icon stays at top (flex-start), text left-aligns */
export const InfoStandaloneMultiLine: Story = {
  args: {
    type: 'info',
    iconProps: infoIconLarge,
    message: longMessage
  }
};

/** No icon: just left-aligned all-caps text */
export const InfoStandaloneNoIcon: Story = {
  args: {
    type: 'info',
    message: shortMessage
  }
};

/** Children prop instead of message */
export const InfoStandaloneWithChildren: Story = {
  args: {
    type: 'info',
    iconProps: infoIconLarge,
    children: 'Form info message passed as children.'
  }
};

// ----------------------------------------
// Info with header
// Icon aligns with header text at top, message below, left-aligned
// ----------------------------------------

/** Short header + short message: icon aligns with header first line */
export const InfoWithHeaderSingleLine: Story = {
  args: {
    type: 'info',
    iconProps: infoIconLarge,
    header: 'Baglioni Spa Renovation',
    message: shortMessage
  }
};

/**
 * Long header that wraps: icon stays at top of header (flex-start),
 * NOT centered across all lines
 */
export const InfoWithHeaderMultiLine: Story = {
  args: {
    type: 'info',
    iconProps: infoIconLarge,
    header:
      'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
    message: richTextContent
  }
};

/** Header only, no message */
export const InfoWithHeaderNoMessage: Story = {
  args: {
    type: 'info',
    iconProps: infoIconLarge,
    header: 'Baglioni Spa Renovation'
  }
};

/** Header + rich text message */
export const InfoWithHeaderAndRichText: Story = {
  args: {
    type: 'info',
    iconProps: infoIconLarge,
    header: 'Baglioni Spa Renovation',
    message: richTextContent
  }
};

/** Header with no icon */
export const InfoWithHeaderNoIcon: Story = {
  args: {
    type: 'info',
    header: 'Baglioni Spa Renovation',
    message: shortMessage
  }
};

