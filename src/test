import { useContext, useEffect, useRef } from 'react';
import { GoogleMapContext } from './googleMapContext';

export const MAX_ZOOM_LEVEL = 15;

export function useMapBounds(
  positions: (google.maps.LatLng | google.maps.LatLngLiteral)[],
  padding: number = 50
) {
  const { map } = useContext(GoogleMapContext);
  const hasFittedRef = useRef(false);

  // Stabilize positions — only refit when lat/lng values actually change
  const positionsKey = positions
    .map(p =>
      p instanceof google.maps.LatLng
        ? `${p.lat()},${p.lng()}`
        : `${p.lat},${p.lng}`
    )
    .join('|');

  useEffect(() => {
    if (!map || !positions.length) return;

    // Only fit bounds once per unique set of positions
    if (hasFittedRef.current) return;
    hasFittedRef.current = true;

    const bounds = new google.maps.LatLngBounds();
    positions.forEach(position => bounds.extend(position));
    map.fitBounds(bounds, padding);

    // Prevent over-zoom
    const listener = google.maps.event.addListenerOnce(map, 'idle', () => {
      if ((map.getZoom() ?? 0) > MAX_ZOOM_LEVEL) {
        map.setZoom(MAX_ZOOM_LEVEL);
      }
    });

    return () => google.maps.event.removeListener(listener);
  }, [map, positionsKey, padding]);

  // Reset when positions actually change
  useEffect(() => {
    hasFittedRef.current = false;
  }, [positionsKey]);
}
