function hasValidCoordinates(hotel: HotelSearchResultFragment): hotel is HotelSearchResultFragment & {
  postalAddress: { geolocation: { latitude: number; longitude: number } }
} {
  return (
    hotel.postalAddress?.geolocation?.latitude != null &&
    hotel.postalAddress?.geolocation?.longitude != null
  )
}

const filteredHotels = hotels?.filter(hasValidCoordinates)
