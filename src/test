@layer basic {
  .formMessage {
    container-type: inline-size;
    margin-block: 0;
  }

  .success {
    color: var(--color-sustainability-green);
    background-color: rgb(from var(--color-sustainability-green) r g b / 20%);
  }

  .error {
    color: var(--color-error);
    background-color: rgb(from var(--color-coral-light) r g b / 20%);

    & a {
      --color: var(--color-error);
      --color-hover: var(--color);
    }
  }

  .info {
    color: var(--color-slate);
    background-color: var(--color-powder-blue);
  }

  .content {
    --font-size-body: 0.875rem;

    display: block;
    padding: var(--spacing-vertical-small) 1.75rem;
    font-family: var(--font-family-secondary);
    font-size: var(--font-size-body);
  }

  /* ----------------------------------------
   * Header row (icon + header text side by side)
   * Default: centered (error/success)
   * ---------------------------------------- */
  .headerMessage {
    justify-content: center;
    text-align: center;
  }

  /* ----------------------------------------
   * Info type: override stack to left-align
   * ---------------------------------------- */
  .infoWrapper {
    --alignment: flex-start;  /* overrides stack utility class alignment */
    text-align: left;
  }

  /* ----------------------------------------
   * Info header row: icon aligns to TOP of
   * text for multi-line, centers for single-line
   * via align-items: flex-start + line-height trick
   * ---------------------------------------- */
  .infoHeaderRow {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;  /* icon stays at top for multi-line */
    gap: var(--spacing-tight, 0.5rem);
  }

  /* ----------------------------------------
   * Info standalone (no header): left-aligned,
   * all caps. Same flex-start icon alignment.
   * ---------------------------------------- */
  .infoStandalone {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
  }

  /* ----------------------------------------
   * Header text
   * ---------------------------------------- */
  .headerText {
    font-size: 0.875rem;
    /* line-height matches icon size so icon optically aligns
       with the first line of text for both single and multi-line */
    line-height: 1.4375rem;
  }

  /* Info-specific text overrides */
  .infoHeaderText {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.125rem;
    line-height: 1.4375rem; /* must match icon --size so first line aligns */
  }

  /* ----------------------------------------
   * Icon
   * flex-shrink: 0 prevents icon from squishing
   * in narrow containers
   * ---------------------------------------- */
  .icon {
    --size: 1.4375rem;
    flex-shrink: 0;
    /* No margin-top needed: line-height on the text
       matches icon height, so flex-start aligns them perfectly */
  }

  /* ----------------------------------------
   * Standalone message (error/success, no header)
   * ---------------------------------------- */
  .standaloneMessage {
    letter-spacing: 0.125rem;
    text-align: center;
    text-transform: uppercase;
    font-weight: var(--font-weight-bold);
  }

  @container (min-width: 30rem) {
    .content {
      padding: 1.5rem 2.1875rem;
    }
  }
}
