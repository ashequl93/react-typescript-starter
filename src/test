import contentful from 'contentful-management';

/**
 * Create advisor versions of TA-only pages by copying existing entries and assigning new slugs.
 *
 * Behavior:
 * - Finds page entries whose slug matches SLUGS_TO_UPDATE (en-US).
 * - Creates a new entry that copies all fields (including references).
 * - Sets the new entry's slug to the mapped advisor slug.
 * - Optionally publishes the new entry.
 * - Optionally unpublishes the original entry.
 *
 * Required env:
 * - CONTENTFUL_MANAGEMENT_TOKEN
 * - CONTENTFUL_SPACE_ID
 * - CONTENTFUL_ENVIRONMENT_ID (ex: "qa", "master", "prod")
 *
 * Optional env:
 * - DRY_RUN ("true" | "false") default true
 * - PUBLISH_NEW ("true" | "false") default false
 * - UNPUBLISH_OLD ("true" | "false") default false
 *
 * Notes:
 * - Slugs are treated as non-localized; en-US is used.
 * - Idempotent: if an entry already exists with the target advisor slug, creation is skipped.
 */

const {
  CONTENTFUL_MANAGEMENT_TOKEN,
  CONTENTFUL_SPACE_ID,
  CONTENTFUL_ENVIRONMENT_ID,
  DRY_RUN = 'true',
  PUBLISH_NEW = 'false',
  UNPUBLISH_OLD = 'false',
} = process.env;

if (!CONTENTFUL_MANAGEMENT_TOKEN || !CONTENTFUL_SPACE_ID || !CONTENTFUL_ENVIRONMENT_ID) {
  console.error(
    'Missing env vars. Need CONTENTFUL_MANAGEMENT_TOKEN, CONTENTFUL_SPACE_ID, CONTENTFUL_ENVIRONMENT_ID'
  );
  process.exit(1);
}

const isDryRun = DRY_RUN !== 'false';
const shouldPublishNew = PUBLISH_NEW === 'true';
const shouldUnpublishOld = UNPUBLISH_OLD === 'true';

const CONTENT_TYPE_ID = 'page';
const SLUG_FIELD_ID = 'slug';
const LOCALE = 'en-US';

const SLUGS_TO_UPDATE = new Set([
  '/login',
  '/register',
  '/forgot-password',
  '/lan-bookings',
  '/profile',
  '/about-lan',
]);

function toAdvisorSlug(oldSlug) {
  switch (oldSlug) {
    case '/login':
      return '/advisor-login';
    case '/forgot-password':
      return '/advisor-forgot-password';
    case '/register':
      return '/advisor-register';
    case '/lan-bookings':
      return '/advisor/lan-bookings';
    case '/profile':
      return '/advisor/profile';
    case '/about-lan':
      return '/advisor/about-lan';
    default:
      return oldSlug;
  }
}

function deepClone(obj) {
  return JSON.parse(JSON.stringify(obj));
}

async function findEntryBySlug(env, slugValue) {
  const resp = await env.getEntries({
    content_type: CONTENT_TYPE_ID,
    [`fields.${SLUG_FIELD_ID}`]: slugValue,
    locale: LOCALE,
    limit: 2,
  });
  return resp.items?.[0] ?? null;
}

async function main() {
  const client = contentful.createClient({
    accessToken: CONTENTFUL_MANAGEMENT_TOKEN,
  });

  const space = await client.getSpace(CONTENTFUL_SPACE_ID);
  const env = await space.getEnvironment(CONTENTFUL_ENVIRONMENT_ID);

  console.log('Environment:', CONTENTFUL_ENVIRONMENT_ID);
  console.log('Locale:', LOCALE);
  console.log('Dry run:', isDryRun);
  console.log('Publish new:', shouldPublishNew);
  console.log('Unpublish old:', shouldUnpublishOld);

  let skip = 0;
  const limit = 100;

  let examinedCount = 0;
  let matchedCount = 0;
  let createdCount = 0;
  let publishedCount = 0;
  let unpublishedOldCount = 0;
  let skippedBecauseExists = 0;

  while (true) {
    const entries = await env.getEntries({
      content_type: CONTENT_TYPE_ID,
      limit,
      skip,
    });

    if (!entries.items.length) break;

    for (const entry of entries.items) {
      examinedCount++;

      const fields = entry.fields || {};
      const slugValue = fields?.[SLUG_FIELD_ID]?.[LOCALE];
      if (!slugValue) continue;

      if (!SLUGS_TO_UPDATE.has(slugValue)) continue;

      const newSlug = toAdvisorSlug(slugValue);
      if (newSlug === slugValue) continue;

      matchedCount++;

      console.log('\nEntry:', entry.sys.id);
      console.log('Old slug:', slugValue);
      console.log('New slug:', newSlug);

      // Idempotency: if target slug already exists, skip creation.
      const existingFinal = await findEntryBySlug(env, newSlug);
      if (existingFinal) {
        console.log(`SKIP: target slug already exists (${newSlug}) -> entry ${existingFinal.sys.id}`);
        skippedBecauseExists++;
        continue;
      }

      if (isDryRun) {
        console.log('DRY_RUN: would create copy with new slug');
        if (shouldPublishNew) console.log('DRY_RUN: would publish new entry');
        if (shouldUnpublishOld) console.log('DRY_RUN: would unpublish old entry');
        createdCount++;
        continue;
      }

      // Create the copy with the final slug immediately (no need for temp slug here).
      const newFields = deepClone(entry.fields);
      if (!newFields[SLUG_FIELD_ID]) newFields[SLUG_FIELD_ID] = {};
      newFields[SLUG_FIELD_ID][LOCALE] = newSlug;

      const created = await env.createEntry(CONTENT_TYPE_ID, { fields: newFields });
      createdCount++;
      console.log('CREATED:', created.sys.id);

      if (shouldPublishNew) {
        const published = await created.publish();
        publishedCount++;
        console.log('PUBLISHED:', published.sys.id);
      }

      if (shouldUnpublishOld) {
        if (entry.sys.publishedVersion) {
          await entry.unpublish();
          unpublishedOldCount++;
          console.log('UNPUBLISHED OLD:', entry.sys.id);
        } else {
          console.log('OLD NOT PUBLISHED: skip unpublish');
        }
      }
    }

    skip += entries.items.length;
    if (skip >= entries.total) break;
  }

  console.log('\nDone.');
  console.log('Examined:', examinedCount);
  console.log('Matched:', matchedCount);
  console.log('Created:', isDryRun ? `${createdCount} (dry-run)` : createdCount);
  console.log('Published:', publishedCount);
  console.log('Old entries unpublished:', unpublishedOldCount);
  console.log('Skipped (target already exists):', skippedBecauseExists);
}

main().catch((e) => {
  console.error('Error:', e);
  process.exit(1);
});
