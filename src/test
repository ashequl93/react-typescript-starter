@layer basic {
  .formMessage {
    container-type: inline-size;
    margin-block: 0;
  }

  .success {
    color: var(--color-sustainability-green);
    background-color: rgb(from var(--color-sustainability-green) r g b / 20%);
  }

  .error {
    color: var(--color-error);
    background-color: rgb(from var(--color-coral-light) r g b / 20%);

    & a {
      --color: var(--color-error);
      --color-hover: var(--color);
    }
  }

  .info {
    color: var(--color-slate);
    background-color: var(--color-powder-blue);
  }

  .content {
    --font-size-body: 0.875rem;

    display: block;
    padding: var(--spacing-vertical-small) 1.75rem;
    font-family: var(--font-family-secondary);
    font-size: var(--font-size-body);
  }

  /* ----------------------------------------
   * Header row (icon + header text side by side)
   * Default: centered (error/success)
   * ---------------------------------------- */
  .headerMessage {
    justify-content: center;
    text-align: center;
  }

  /* ----------------------------------------
   * Info type: override stack to left-align
   * ---------------------------------------- */
  .infoWrapper {
    --alignment: flex-start;
    text-align: left;
  }

  /* ----------------------------------------
   * Info header row: flex row, icon at top for
   * multi-line via flex-start + line-height trick
   * ---------------------------------------- */
  .infoHeaderRow {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: var(--spacing-tight, 0.5rem);
  }

  /* ----------------------------------------
   * Info standalone (no header)
   * Left-aligned, icon at top for multi-line
   * ---------------------------------------- */
  .infoStandalone {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--spacing-tight, 0.5rem);
    text-align: left;
  }

  /* ----------------------------------------
   * Non-info standalone (error/success, no header)
   * Centered. Icon stacks ABOVE text via flex-column
   * so multi-line text stays centered below icon.
   * ---------------------------------------- */
  .standaloneMessage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-tight, 0.5rem);
    letter-spacing: 0.125rem;
    text-align: center;
    text-transform: uppercase;
    font-weight: var(--font-weight-bold);
  }

  /* ----------------------------------------
   * Header text
   * line-height matches icon --size so that with
   * flex-start, the icon optically aligns with the
   * first line of text (works for single AND multi-line)
   * ---------------------------------------- */
  .headerText {
    font-size: 0.875rem;
    line-height: 1.4375rem;
  }

  /* Info-specific text: all caps, left-aligned */
  .infoHeaderText {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.125rem;
    line-height: 1.4375rem;
    text-align: left;
  }

  /* ----------------------------------------
   * Icon used in row layouts (info rows)
   * flex-shrink: 0 prevents squishing in row direction
   * ---------------------------------------- */
  .icon {
    --size: 1.4375rem;
    flex-shrink: 0;
  }

  /* ----------------------------------------
   * Icon used in column layout (non-info standalone)
   * No flex-shrink needed in column direction
   * ---------------------------------------- */
  .iconStandalone {
    --size: 1.4375rem;
  }

  @container (min-width: 30rem) {
    .content {
      padding: 1.5rem 2.1875rem;
    }
  }
}
